# Mip server
MIP_HOST=0.0.0.0
MIP_PORT=8088
MIP_BEARER_TOKEN=change-me-to-a-random-string

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
MIP_PRIMARY_MODEL=qwen2.5-coder:14b
MIP_FALLBACK_MODEL=qwen2.5-coder:7b
MIP_EMBED_MODEL=nomic-embed-text

# Qdrant
QDRANT_URL=http://localhost:6333
MIP_DEFAULT_COLLECTION=inthink

# State (sqlite for project registry + sha tracking)
MIP_STATE_DB=./data/state.db

# Logs
MIP_LOG_LEVEL=INFO
