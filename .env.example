# Mip server
MIP_HOST=0.0.0.0
MIP_PORT=8088
MIP_BEARER_TOKEN=change-me-to-a-random-string

# Chat backend selection.
#   openai_compat — forward to any OpenAI-format provider (Groq, OpenRouter, Gemini, OpenAI).
#   ollama        — local Ollama (offline / private; weaker quality on 14B-class models).
MIP_CHAT_BACKEND=openai_compat

# OpenAI-compatible chat backend config. Defaults are Groq.
#   Groq:       https://api.groq.com/openai/v1                 — keys: https://console.groq.com/keys
#   OpenRouter: https://openrouter.ai/api/v1                   — keys: https://openrouter.ai/keys
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
#   OpenAI:     https://api.openai.com/v1
MIP_CHAT_BASE_URL=https://api.groq.com/openai/v1
MIP_CHAT_API_KEY=

# Default model the client sees in /v1/models. Must match the chat backend's naming:
#   Groq:   llama-3.3-70b-versatile, qwen-2.5-coder-32b, llama-3.1-8b-instant
#   Ollama: qwen2.5-coder:14b
MIP_PRIMARY_MODEL=llama-3.3-70b-versatile
MIP_FALLBACK_MODEL=llama-3.1-8b-instant

# Local Ollama — always used for embeddings (nomic-embed-text). Also used for chat
# when MIP_CHAT_BACKEND=ollama. Keep Ollama installed even on the openai_compat path.
OLLAMA_BASE_URL=http://localhost:11434
MIP_EMBED_MODEL=nomic-embed-text

# Qdrant
QDRANT_URL=http://localhost:6333
MIP_DEFAULT_COLLECTION=inthink

# State (sqlite for project registry + sha tracking)
MIP_STATE_DB=./data/state.db

# Logs
MIP_LOG_LEVEL=INFO
